# ==============================================================================
# BHARAT MARKET INTELLIGENCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development

# Storage Settings
DATABASE_URL=sqlite:///./data/market_intel.db
DUCKDB_PATH=./data/historical/markets.duckdb
DATA_DIR=./data

# Timezone & Scheduling (Indian Standard Time)
TIMEZONE=Asia/Kolkata
MORNING_SCHEDULE_TIME=08:30
INTRADAY_POLL_INTERVAL_MINUTES=15
EVENING_SCHEDULE_TIME=15:45
SCREENER_SCHEDULE_TIME=18:00

# AI Research Layer Settings
# Supported values: rule_based (always works offline), gemini, ollama
DEFAULT_AI_PROVIDER=rule_based
# Optional Google Gemini Free Tier Key (Leave blank to use built-in rule-based engine)
GEMINI_API_KEY=
# Optional Local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Data Provider Configuration
NSE_REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_INTRADAY_SECONDS=30
CACHE_TTL_EOD_HOURS=24
DATA_QUALITY_STRICT_MODE=true
MAX_PARALLEL_DOWNLOADS=3

