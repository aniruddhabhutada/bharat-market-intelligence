# Environment Variables & secrets (Do not commit live keys or credentials)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
!*.example

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Netlify & Vercel
.netlify/
frontend/.netlify/
.vercel/

# OS Files
.DS_Store
Thumbs.db

